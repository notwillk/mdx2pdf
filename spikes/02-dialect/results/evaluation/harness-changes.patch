+fn esm_stricter(tree: &Node, input: &str) -> bool {
+    let quoted_from = |rest: &str| rest.split(" from ").skip(1).any(|t| t.trim_start().starts_with(['"', '\'']));
+    let looks = |line: &str| {
+        let Some((word, rest)) = line.split_once(' ') else { return false };
+        let rest = rest.trim();
+        match word {
+            "import" => rest.starts_with(['"', '\'', '{', '*']) || quoted_from(rest),
+            "export" => ["const ", "let ", "var ", "function ", "class ", "default ", "async "].iter().any(|k| rest.starts_with(k)) || rest.starts_with(['{', '*']),
+            _ => false,
+        }
+    };
+    tree.children().is_some_and(|c| c.iter().any(|n| {
+        let Node::Paragraph(p) = n else { return false };
+        let Some(pos) = p.position.as_ref().filter(|x| x.start.column == 1) else { return false };
+        looks(input[pos.start.offset..].lines().next().unwrap_or(""))
+    }))
+}
